[init]
	defaultBranch = main
[pull]
	ff = only
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
