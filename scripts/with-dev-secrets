#!/usr/bin/env bash

set -eu

usage() {
  cat <<'EOF'
Usage: with-dev-secrets VAR[,VAR...] -- command [args...]

Load explicit variables from login Keychain services named dev.env.<VARIABLE>,
then execute one child process. Values are never printed or installed in the
calling shell.
EOF
}

fail() {
  printf 'with-dev-secrets: %s\n' "$*" >&2
  exit 2
}

[ "$#" -ge 3 ] || { usage >&2; exit 2; }
requested="$1"
shift
[ "${1:-}" = "--" ] || fail "expected -- before the command"
shift
[ "$#" -gt 0 ] || fail "a command is required"
command_args=("$@")

security_bin="${DEV_SECRETS_SECURITY_BIN:-/usr/bin/security}"
[ -x "$security_bin" ] || fail "Keychain command is unavailable"
account="$(id -un)"

# Prevent a stale parent terminal from leaking formerly-global credentials to
# the child. Only explicitly requested names are reintroduced below.
for known_name in \
  GITHUB_PERSONAL_ACCESS_TOKEN \
  GOOGLE_CLIENT_ID \
  GOOGLE_CLIENT_SECRET \
  ANTHROPIC_API_KEY \
  GEMINI_API_KEY \
  CLICKUP_API_TOKEN
do
  unset "$known_name"
done

old_ifs="$IFS"
IFS=',' read -r -a variable_names <<< "$requested"
IFS="$old_ifs"

[ "${#variable_names[@]}" -gt 0 ] || fail "at least one variable is required"
for variable_name in "${variable_names[@]}"; do
  case "$variable_name" in
    ''|[0-9]*|*[!A-Za-z0-9_]*) fail "invalid variable name" ;;
  esac

  variable_value="$($security_bin find-generic-password -a "$account" -s "dev.env.$variable_name" -w 2>/dev/null)" ||
    fail "Keychain item is unavailable for $variable_name"
  [ -n "$variable_value" ] || fail "Keychain item is empty for $variable_name"
  export "$variable_name=$variable_value"
  unset variable_value
done

exec "${command_args[@]}"
